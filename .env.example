# Cache-Control Analyzer -- example environment configuration
# Copy this file to .env and adjust as needed. All values are optional;
# sensible defaults are used if unset. CLI flags always override these.

# Request timeout, in seconds
CCA_TIMEOUT=10

# User-Agent header sent with requests
CCA_USER_AGENT=CacheControlAnalyzer/1.0

# Whether to follow redirects (true/false)
CCA_FOLLOW_REDIRECTS=true

# Maximum number of redirects to follow
CCA_MAX_REDIRECTS=5

# Disable TLS certificate verification (lab/testing only!)
CCA_INSECURE=false

# Skip fetching/analyzing response bodies
CCA_NO_BODY=false

# Maximum response body size to read, in bytes
CCA_MAX_BODY_BYTES=262144

# Batch mode: concurrent worker count
CCA_WORKERS=5

# Batch mode: max requests per second across all workers
CCA_RATE_LIMIT=5

# Batch mode: retries for transient network errors
CCA_RETRIES=2

# Directory where generated reports are written by default
CCA_OUTPUT_DIR=output

# Logging level: DEBUG, INFO, WARNING, ERROR
CCA_LOG_LEVEL=INFO
